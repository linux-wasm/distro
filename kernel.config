# Kernel options the distro enables on top of the kernel's tinyconfig
# (scripts/build.sh kernel). One CONFIG_ name per line.
#
# /proc: ps, free, mount and friends read it. /proc/sys: kernel settings.
PROC_FS
PROC_SYSCTL
# setitimer and alarm (the timer_* calls come with it): read -t, timeouts.
POSIX_TIMERS
# Users other than root, and the permission checks that go with them.
MULTIUSER
# Disks are virtio block devices that the host provides. The root file
# system is a read-only erofs image with an ext4 file system for the
# changes on top (overlayfs), see rootfs/sbin/overlay-init.
BLOCK
VIRTIO_WASM
VIRTIO_BLK
MISC_FILESYSTEMS
EROFS_FS
EXT4_FS
EXT4_FS_POSIX_ACL
EXT4_FS_SECURITY
OVERLAY_FS
# Shell scripts as programs (#!).
BINFMT_SCRIPT
# /dev is filled in by the kernel and /sys describes the devices. (/tmp
# and /run are "tmpfs", which without an MMU is ramfs under that name.)
DEVTMPFS
DEVTMPFS_MOUNT
SYSFS
# Pseudo terminals (/dev/pts).
UNIX98_PTYS
# Event interfaces that anything beyond a shell expects.
EPOLL
EVENTFD
SIGNALFD
TIMERFD
INOTIFY_USER
FILE_LOCKING
