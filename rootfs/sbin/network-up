#!/bin/sh
# Bring up the network, from /etc/inittab. The network card, if the host
# provides one, is on the host's user-mode network, where the addresses
# are fixed: this machine is 10.0.2.15, the gateway 10.0.2.2 and the name
# server 10.0.2.3 (/etc/resolv.conf).
ifconfig lo 127.0.0.1 up
[ -e /sys/class/net/eth0 ] || exit 0
ifconfig eth0 10.0.2.15 netmask 255.255.255.0 up
route add default gw 10.0.2.2
