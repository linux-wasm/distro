# Exact versions of everything the distro is built from.
# Read by scripts/common.sh; change a version here, in its own commit.

# Kernel: https://github.com/linux-wasm/linux (branch wasm-port)
KERNEL_REPO=https://github.com/linux-wasm/linux.git
KERNEL_COMMIT=0fec4ed1daef4711ad0acddb773d5b1a9717d89b

# C library: https://github.com/linux-wasm/musl (branch wasm-port).
MUSL_REPO=https://github.com/linux-wasm/musl.git
MUSL_COMMIT=60abd69731b24a5b7e72bbdfb9d6a2553ef6eff8

# Packages (busybox, bash, coreutils, ncurses, ...): build recipes in
# https://github.com/linux-wasm/ports (branch main).
PORTS_REPO=https://github.com/linux-wasm/ports.git
PORTS_COMMIT=58bb5a3a984a59b9e13990dcd52e319bb07b9997

# The WebSocket to TCP/UDP proxy that gives the system a network:
# https://github.com/linux-wasm/netproxy (branch main). Not part of what
# is built; scripts/test.sh runs it for the network test.
NETPROXY_REPO=https://github.com/linux-wasm/netproxy.git
NETPROXY_COMMIT=27b5ee1f462b261ad69e35329f488c0799baacf7

# The terminal emulator of the web page: xterm.js releases from the npm
# registry, checked against these SHA-512 digests (the registry's
# "integrity" values).
XTERM_URL=https://registry.npmjs.org/@xterm/xterm/-/xterm-5.5.0.tgz
XTERM_SHA512=hqJHYaQb5OptNunnyAnkHyM8aCjZ1MEIDTQu1iIbbTD/xops91NB5yq1ZK/dC2JDbVWtF23zUtl9JE2NqwT87A==
XTERM_FIT_URL=https://registry.npmjs.org/@xterm/addon-fit/-/addon-fit-0.10.0.tgz
XTERM_FIT_SHA512=UFYkDm4HUahf2lnEyHvio51TNGiLK66mqP2JoATy7hRZeXaGMRDr00JiSF7m63vR5WKATF605yEggJKsw0JpMQ==
XTERM_WEBGL_URL=https://registry.npmjs.org/@xterm/addon-webgl/-/addon-webgl-0.18.0.tgz
XTERM_WEBGL_SHA512=xCnfMBTI+/HKPdRnSOHaJDRqEpq2Ugy8LEj9GiY4J3zJObo3joylIFaMvzBwbYRg8zLtkO0KQaStCeSfoaI2/w==
